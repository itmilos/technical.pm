---
export interface Props {
	id?: string;
	title?: string;
	subtitle?: string;
	formId?: string;
	buttonText?: string;
	fields?: FormField[];
	toolName?: string;
	toolDescription?: string;
}

export interface FormField {
	type: 'text' | 'email' | 'textarea' | 'select';
	id: string;
	name: string;
	label: string;
	icon?: string;
	required?: boolean;
	options?: { value: string; label: string }[];
	rows?: number;
	maxLength?: number;
	toolParamDescription?: string;
}

const {
	id = 'animated-contact-form',
	title = "Get in Touch",
	subtitle = "Let's discuss how we can work together",
	formId = 'contact-form',
	buttonText = "Send Message",
	fields = [
		{ type: 'text', id: 'name', name: 'name', label: 'How we should call you?', required: true, toolParamDescription: "The visitor's name" },
		{ type: 'email', id: 'email', name: 'email', label: 'Email Address', required: true, toolParamDescription: "The visitor's email address, for a reply" },
		{ type: 'select', id: 'subject', name: 'subject', label: 'Subject', required: true, toolParamDescription: 'What the inquiry is about', options: [
			{ value: 'general', label: 'General Inquiry' },
			{ value: 'consultation', label: 'Book a Consultation' },
			{ value: 'project', label: 'Project Discussion' },
			{ value: 'engagement', label: 'Full Engagement' },
			{ value: 'other', label: 'Other' }
		]},
		{ type: 'textarea', id: 'message', name: 'message', label: 'Tell us about your needs', required: true, rows: 4, toolParamDescription: 'A description of what the visitor needs' }
	],
	toolName = 'send-contact-message',
	toolDescription = 'Send a contact message to Milos Rujevic on behalf of a site visitor. Requires explicit human instruction — never submit this on a visitor\'s behalf without them asking to.'
} = Astro.props;
---

<div class="contact-form">
	<form id={formId} class="space-y-5" toolname={toolName} tooldescription={toolDescription}>
		{fields.map((field) => (
			<div class="input-group">
				<label for={field.id} class="form-label font-primary">
					{field.label}{field.required && <span class="required-mark">*</span>}
				</label>
				<div class="input-wrapper">
					{field.type === 'textarea' ? (
						<textarea
							id={field.id}
							name={field.name}
							rows={field.rows || 4}
							class="animated-input"
							required={field.required}
							maxlength={field.maxLength || 1000}
							toolparamdescription={field.toolParamDescription}
						></textarea>
					) : field.type === 'select' ? (
						<select
							id={field.id}
							name={field.name}
							class="animated-input"
							required={field.required}
							toolparamdescription={field.toolParamDescription}
						>
							<option value="" disabled selected>Select an option</option>
							{field.options?.map((option) => (
								<option value={option.value}>{option.label}</option>
							))}
						</select>
					) : (
						<input
							type={field.type}
							id={field.id}
							name={field.name}
							class="animated-input"
							required={field.required}
							toolparamdescription={field.toolParamDescription}
						/>
					)}
				</div>
			</div>
		))}

		<div class="text-center pt-2">
			<button type="submit" class="submit-btn font-accent">
				{buttonText}
			</button>
		</div>
	</form>
</div>

<style>
	.contact-form {
		width: 100%;
	}

	.input-group {
		margin-bottom: 20px;
	}

	.form-label {
		display: block;
		margin-bottom: 6px;
		font-size: 14px;
		font-weight: 500;
		color: var(--text-secondary);
	}

	.required-mark {
		color: var(--accent-primary);
		margin-left: 2px;
	}

	.input-wrapper {
		position: relative;
	}

	.input-wrapper.invalid .animated-input {
		border-color: #FF4F58;
	}

	.animated-input {
		width: 100%;
		padding: 10px 12px;
		background: var(--bg-secondary);
		border: 1px solid var(--border-primary);
		border-radius: 8px;
		color: var(--text-primary);
		font-size: 16px;
		font-family: var(--font-primary);
		line-height: 1.5;
		box-sizing: border-box;
	}

	.animated-input:focus {
		outline: none;
		border-color: var(--accent-primary);
	}

	textarea.animated-input {
		resize: vertical;
		min-height: 100px;
	}

	select.animated-input {
		cursor: pointer;
	}

	.submit-btn {
		display: inline-block;
		padding: 12px 32px;
		background: var(--accent-primary);
		color: white;
		font-size: 16px;
		font-weight: 600;
		border: none;
		border-radius: 8px;
		cursor: pointer;
	}

	.submit-btn:hover {
		background: var(--accent-secondary);
	}

	.submit-btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', function() {
		const forms = document.querySelectorAll('.contact-form form') as NodeListOf<HTMLFormElement>;

		forms.forEach(form => {
			const inputs = form.querySelectorAll('.animated-input') as NodeListOf<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>;

			inputs.forEach(input => {
				const wrapper = input.parentElement as HTMLElement;

				input.addEventListener('input', function() {
					if (input.checkValidity()) {
						wrapper?.classList.remove('invalid');
					} else if (input.value.length > 0) {
						wrapper?.classList.add('invalid');
					} else {
						wrapper?.classList.remove('invalid');
					}
				});
			});

			registerFillTool(form, inputs);
		});
	});

	// Registers a real WebMCP tool (document.modelContext.registerTool) that
	// lets a browser-based agent fill this form's fields from the same
	// toolname/tooldescription/toolparamdescription attributes already used
	// for declarative (crawler-read) discovery. The tool only fills fields
	// and reveals the form if it's inside a hidden modal -- it never submits.
	// That stays a human action, same as the "draft, don't send" pattern
	// used for every contact form on this site. Feature-detected: falls
	// back to the declarative attributes alone in browsers without WebMCP.
	function registerFillTool(
		form: HTMLFormElement,
		inputs: NodeListOf<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>
	) {
		const modelContext = (document as unknown as { modelContext?: { registerTool: (tool: unknown) => Promise<unknown> } }).modelContext;
		if (!modelContext) return;

		const toolName = form.getAttribute('toolname');
		const toolDescription = form.getAttribute('tooldescription');
		if (!toolName || !toolDescription) return;

		const properties: Record<string, { type: string; description?: string; enum?: string[] }> = {};
		const required: string[] = [];

		inputs.forEach((field) => {
			const name = field.getAttribute('name');
			if (!name) return;
			const description = field.getAttribute('toolparamdescription') || undefined;
			const property: { type: string; description?: string; enum?: string[] } = { type: 'string' };
			if (description) property.description = description;
			if (field instanceof HTMLSelectElement) {
				const values = Array.from(field.options).map((o) => o.value).filter(Boolean);
				if (values.length) property.enum = values;
			}
			properties[name] = property;
			if (field.hasAttribute('required')) required.push(name);
		});

		modelContext.registerTool({
			name: toolName,
			description: `${toolDescription} This fills the form's fields; it does not submit anything -- a human must review and click send.`,
			inputSchema: { type: 'object', properties, required },
			annotations: { readOnlyHint: false, consequentialHint: false, untrustedContentHint: false },
			execute: async (input: Record<string, string>) => {
				const filledFields: string[] = [];
				Object.entries(input || {}).forEach(([key, value]) => {
					const field = form.querySelector(`[name="${key}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
					if (!field) return;
					field.value = String(value);
					field.dispatchEvent(new Event('input', { bubbles: true }));
					field.dispatchEvent(new Event('change', { bubbles: true }));
					filledFields.push(key);
				});

				const dialog = form.closest('[role="dialog"]') as HTMLElement | null;
				dialog?.classList.remove('hidden');

				return {
					status: 'drafted',
					formId: form.id,
					filledFields,
					message: 'Form filled. A human must review and submit it -- this tool never sends anything itself.',
				};
			},
		}).catch(() => {
			// WebMCP registration failed (e.g. mid-spec browser change) --
			// declarative attributes remain as the fallback discovery path.
		});
	}
</script>
