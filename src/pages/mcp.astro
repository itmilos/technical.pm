---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import WebGLBackground from '../components/WebGLBackground.astro';
import Modal from '../components/Modal.astro';
import AnimatedContactForm from '../components/AnimatedContactForm.astro';
import { meta, hero, caseStudy, principles, checklist } from '../data/mcpContent';

// set:html (not inline {} interpolation, which Astro does not evaluate
// inside <script> tag content) so this actually renders as real JSON-LD.
const articleSchemaJson = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": hero.headline,
	"description": meta.description,
	"datePublished": meta.datePublished,
	"dateModified": meta.datePublished,
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": "https://technical.pm/mcp"
	}
});
---

<Layout
	title={meta.title}
	description={meta.description}
	image="/seo/og-image.png"
	article={true}
	hideIdentity={true}
>
	<script type="application/ld+json" set:html={articleSchemaJson} />

	<WebGLBackground />

	<!-- Hero -->
	<section id="hero" class="container mx-auto px-4 py-16 sm:py-20 md:py-24 max-w-6xl text-center relative z-10">
		<p class="text-sm font-semibold tracking-wide uppercase mb-3 font-accent" style="color: var(--accent-primary);">{hero.eyebrow}</p>
		<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 leading-tight">
			{hero.headline}
		</h1>
		<p class="text-lg sm:text-xl mb-8 max-w-3xl mx-auto leading-relaxed font-primary" style="color: var(--text-secondary);">
			{hero.subhead}
		</p>
		<div class="flex flex-col sm:flex-row gap-4 justify-center">
			<a
				href="#case-study"
				class="inline-block px-6 sm:px-8 py-3 font-semibold rounded-lg shadow transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 text-sm sm:text-base"
				style="background: var(--accent-primary); color: white;"
			>
				See what I've built
			</a>
			<button
				type="button"
				onclick="document.getElementById('consultation-modal').classList.remove('hidden'); return false;"
				class="inline-block px-6 sm:px-8 py-3 font-semibold rounded-lg border transition-all duration-300 hover:scale-105 text-sm sm:text-base"
				style="border-color: var(--border-primary); color: var(--text-primary);"
			>
				Talk MCP strategy
			</button>
		</div>
	</section>

	<!-- Case Study -->
	<section id="case-study" class="container mx-auto px-4 mb-16 sm:mb-20 max-w-6xl relative z-10">
		<h2 class="text-2xl sm:text-3xl font-semibold mb-4 text-center">{caseStudy.title}</h2>
		<p class="text-center max-w-3xl mx-auto mb-10 leading-relaxed font-primary" style="color: var(--text-secondary);">
			{caseStudy.intro}
		</p>

		<div class="grid sm:grid-cols-2 gap-6 mb-12">
			{caseStudy.facts.map((fact) => (
				<div class="glass-card rounded-lg p-6">
					<h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">{fact.title}</h3>
					<p class="text-sm leading-relaxed font-primary" style="color: var(--text-secondary);">{fact.detail}</p>
				</div>
			))}
		</div>

		<!-- Architecture diagram -->
		<div class="glass-card rounded-lg p-6 sm:p-8">
			<h3 class="text-base font-semibold mb-6 text-center" style="color: var(--text-primary);">How the pieces fit together</h3>
			<svg viewBox="0 0 780 260" role="img" aria-labelledby="mcp-diagram-title" class="w-full h-auto" style="color: var(--text-primary);">
				<title id="mcp-diagram-title">An AI agent reaches the platform either through a 5-tool public payer server, or through a 33-tool authenticated server split into merchant and reseller tools; both talk to the same underlying platform API.</title>

				<!-- Agent -->
				<rect x="10" y="100" width="140" height="60" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
				<text x="80" y="135" text-anchor="middle" font-size="16" fill="currentColor" font-weight="600">AI Agent</text>

				<!-- Public payer server -->
				<rect x="270" y="20" width="220" height="70" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
				<text x="380" y="48" text-anchor="middle" font-size="14" fill="currentColor" font-weight="600">Public payer server</text>
				<text x="380" y="68" text-anchor="middle" font-size="12" fill="currentColor" opacity="0.75">5 tools · no merchant creds</text>

				<!-- Authenticated server -->
				<rect x="270" y="170" width="220" height="70" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
				<text x="380" y="198" text-anchor="middle" font-size="14" fill="currentColor" font-weight="600">Authenticated server</text>
				<text x="380" y="218" text-anchor="middle" font-size="12" fill="currentColor" opacity="0.75">33 tools · merchant + reseller</text>

				<!-- Platform API -->
				<rect x="590" y="100" width="180" height="60" rx="10" fill="none" stroke="currentColor" stroke-width="2"/>
				<text x="680" y="127" text-anchor="middle" font-size="14" fill="currentColor" font-weight="600">Platform API</text>
				<text x="680" y="145" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.75">REST / OpenAPI</text>

				<!-- Arrows -->
				<line x1="150" y1="120" x2="270" y2="60" stroke="currentColor" stroke-width="2" marker-end="url(#mcp-arrow)"/>
				<line x1="150" y1="140" x2="270" y2="205" stroke="currentColor" stroke-width="2" marker-end="url(#mcp-arrow)"/>
				<line x1="490" y1="60" x2="590" y2="120" stroke="currentColor" stroke-width="2" marker-end="url(#mcp-arrow)"/>
				<line x1="490" y1="205" x2="590" y2="140" stroke="currentColor" stroke-width="2" marker-end="url(#mcp-arrow)"/>

				<defs>
					<marker id="mcp-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
						<path d="M0,0 L8,4 L0,8 Z" fill="currentColor"/>
					</marker>
				</defs>
			</svg>
		</div>
	</section>

	<!-- Principles -->
	<section id="principles" class="container mx-auto px-4 mb-16 sm:mb-20 max-w-6xl relative z-10">
		<h2 class="text-2xl sm:text-3xl font-semibold mb-10 text-center">Principles</h2>
		<div class="grid md:grid-cols-2 gap-6">
			{principles.map((principle) => (
				<div class="glass-card rounded-lg p-6 flex flex-col">
					<h3 class="text-lg font-semibold mb-2" style="color: var(--text-primary);">{principle.title}</h3>
					<p class="text-sm leading-relaxed font-primary mb-4" style="color: var(--text-secondary);">{principle.opinion}</p>
					<div class="mt-auto pt-4 border-t" style="border-color: var(--border-primary);">
						<p class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--accent-primary);">
							{principle.status === 'applied' ? 'How I applied it' : "What I'd do"}
						</p>
						<p class="text-sm leading-relaxed font-primary" style="color: var(--text-secondary);">{principle.note}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Checklist -->
	<section id="checklist" class="container mx-auto px-4 mb-16 sm:mb-20 max-w-4xl relative z-10">
		<h2 class="text-2xl sm:text-3xl font-semibold mb-4 text-center">Is your MCP server production-ready?</h2>
		<p class="text-center max-w-2xl mx-auto mb-8 leading-relaxed font-primary" style="color: var(--text-secondary);">
			Check off what's true today. This stays in your browser — nothing is sent anywhere.
		</p>

		<div
			class="glass-card rounded-lg p-6 sm:p-8"
			id="mcp-checklist"
			{...{
				toolname: 'get-mcp-readiness-checklist',
				tooldescription: 'Read-only. Returns the MCP production-readiness checklist items as structured data — does not submit or change anything.',
			}}
		>
			<div class="flex items-center justify-between mb-6 gap-4">
				<span class="text-sm font-semibold" style="color: var(--text-primary);">Score</span>
				<span id="mcp-checklist-score" class="text-sm font-semibold font-accent" style="color: var(--accent-primary);">0 / {checklist.length}</span>
			</div>
			<div class="w-full h-2 rounded-full mb-8" style="background: var(--bg-tertiary);">
				<div id="mcp-checklist-bar" class="h-2 rounded-full" style="width: 0%; background: var(--accent-primary);"></div>
			</div>

			<ul class="space-y-4">
				{checklist.map((item) => (
					<li class="flex items-start gap-3">
						<input
							type="checkbox"
							id={`mcp-check-${item.id}`}
							class="mcp-checklist-input mt-1 w-4 h-4 flex-shrink-0"
							data-checklist-item={item.id}
						/>
						<label for={`mcp-check-${item.id}`} class="text-sm leading-relaxed font-primary" style="color: var(--text-secondary);">
							{item.label}
						</label>
					</li>
				))}
			</ul>

			<div id="mcp-checklist-cta" class="hidden mt-8 pt-6 border-t text-center" style="border-color: var(--border-primary);">
				<p class="text-sm mb-4 font-primary" style="color: var(--text-secondary);">
					A handful of gaps is normal — most of these take a focused sprint, not a rebuild.
				</p>
				<button
					type="button"
					onclick="document.getElementById('consultation-modal').classList.remove('hidden'); return false;"
					class="inline-block px-6 py-3 font-semibold rounded-lg shadow transition-all duration-300 hover:scale-105 text-sm"
					style="background: var(--accent-primary); color: white;"
				>
					Talk MCP strategy
				</button>
			</div>
		</div>
	</section>

	<!-- Closing CTA -->
	<section class="container mx-auto px-4 mb-16 max-w-4xl relative z-10">
		<div class="glass-primary rounded-lg p-8 text-center">
			<h2 class="text-2xl font-semibold mb-4">Building an MCP server, or deciding whether to?</h2>
			<p class="mb-6 leading-relaxed font-primary" style="color: var(--text-secondary);">
				I help teams design the tool surface, the access model, and the governance around it before it ships — not after.
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<button
					type="button"
					onclick="document.getElementById('consultation-modal').classList.remove('hidden'); return false;"
					class="inline-block px-6 sm:px-8 py-3 bg-royal-purple-600 text-white font-semibold rounded-lg shadow hover:bg-electric-lavender-500 transition-all duration-300 hover:scale-105 hover:shadow-lg active:scale-95 text-sm sm:text-base font-accent cursor-pointer"
				>
					Talk MCP strategy
				</button>
				<button
					type="button"
					onclick="document.getElementById('contact-modal').classList.remove('hidden'); return false;"
					class="inline-block px-6 sm:px-8 py-3 font-semibold rounded-lg border transition-all duration-300 hover:scale-105 text-sm sm:text-base"
					style="border-color: var(--border-primary); color: var(--text-primary);"
				>
					Send a message
				</button>
			</div>
			<p class="mt-6 text-xs" style="color: var(--text-tertiary);">
				Technical references on this page verified against the MCP spec, revision <a href={meta.specUrl} class="underline" style="color: var(--text-tertiary);">{meta.specRevision}</a>.
			</p>
		</div>
	</section>

	<!-- Consultation Modal -->
	<Modal id="consultation-modal" title="Talk MCP Strategy" subtitle="Let's discuss your MCP server's tool surface, access model, and rollout">
		<AnimatedContactForm
			formId="mcp-consultation-form"
			buttonText="Book Consultation"
			toolName="book-mcp-consultation"
			toolDescription="Request an MCP strategy consultation. Requires explicit human instruction — never submit this on a visitor's behalf without them asking to."
			fields={[
				{ type: 'text', id: 'mcp-name', name: 'name', label: 'How we should call you?', required: true, toolParamDescription: "The visitor's name" },
				{ type: 'email', id: 'mcp-email', name: 'email', label: 'Email Address', required: true, toolParamDescription: "The visitor's email address, for a reply" },
				{ type: 'text', id: 'mcp-company', name: 'company', label: 'Company/Organization', required: false, toolParamDescription: "The visitor's company or organization, if any" },
				{ type: 'textarea', id: 'mcp-goals', name: 'message', label: 'What are you building (or trying to fix)?', required: true, rows: 4, toolParamDescription: 'A description of the MCP server or platform the visitor is working on and what they need help with' }
			]}
		/>
	</Modal>

	<!-- General Contact Modal (shared header "Contact" nav target) -->
	<Modal id="contact-modal" title="Get in Touch" subtitle="Let's discuss how we can work together">
		<AnimatedContactForm
			formId="mcp-contact-form"
			buttonText="Send Message"
			toolName="send-general-inquiry"
			toolDescription="Send a general contact message. Requires explicit human instruction — never submit this on a visitor's behalf without them asking to."
			fields={[
				{ type: 'text', id: 'mcp-contact-name', name: 'name', label: 'How we should call you?', required: true, toolParamDescription: "The visitor's name" },
				{ type: 'email', id: 'mcp-contact-email', name: 'email', label: 'Email Address', required: true, toolParamDescription: "The visitor's email address, for a reply" },
				{ type: 'textarea', id: 'mcp-contact-message', name: 'message', label: 'Tell us about your project', required: true, rows: 4, toolParamDescription: 'A description of the project or inquiry' }
			]}
		/>
	</Modal>

	<footer class="text-center text-sm py-6 relative" style="color: var(--text-secondary);">
		<div class="flex flex-col sm:flex-row items-center justify-center gap-2">
			<span style="color: var(--text-secondary);">© 2025. All rights reserved.</span>
		</div>
	</footer>
</Layout>

<style>
	@media (prefers-reduced-motion: reduce) {
		#mcp-checklist-bar {
			transition: none;
		}
	}
	#mcp-checklist-bar {
		transition: width 0.3s ease;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		const inputs = document.querySelectorAll('.mcp-checklist-input') as NodeListOf<HTMLInputElement>;
		const scoreEl = document.getElementById('mcp-checklist-score');
		const barEl = document.getElementById('mcp-checklist-bar');
		const ctaEl = document.getElementById('mcp-checklist-cta');
		const total = inputs.length;

		function update() {
			const checked = Array.from(inputs).filter((i) => i.checked).length;
			if (scoreEl) scoreEl.textContent = `${checked} / ${total}`;
			if (barEl) barEl.style.width = `${total ? (checked / total) * 100 : 0}%`;
			if (ctaEl) {
				const ratio = total ? checked / total : 0;
				ctaEl.classList.toggle('hidden', ratio >= 0.6 || checked === 0);
			}
		}

		inputs.forEach((input) => input.addEventListener('change', update));
		update();
	});
</script>
